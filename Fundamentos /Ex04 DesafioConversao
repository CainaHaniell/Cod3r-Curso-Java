package Fundamentos;
import java.util.Scanner;
import java.util.Locale;
public class Ex04DesafioConversao {
	
	public static void main ( String [] args) {
		
		Locale.setDefault(new Locale("en","US", "pt-BR"));
				
		Scanner salario = new Scanner(System.in);
			
		System.out.println("Digite seu primeiro salário: ");
		String Sal1 = salario.next().replace(",", ".");
		
		System.out. println("Digite seu segundo salario: ");
		String Sal2 = salario.next().replace(",", ".");
		
		System.out.println("Digite seu terceiro salario: ");
		String Sal3 = salario.next().replace(",", ".");
	
		
		double salario1 = Double.parseDouble(Sal1);
		double salario2 = Double.parseDouble(Sal2);
		double salario3 = Double.parseDouble(Sal3);
		
		double soma = (salario1 + salario2 + salario3);
		double media = soma /3;
		
		System.out.println("A soma dos seus três (3) salário é de: " + soma + " R$" );
		System.out.println("A média do seu salário é: " + media + " R$" );
		
		salario.close();
		
	}
}
