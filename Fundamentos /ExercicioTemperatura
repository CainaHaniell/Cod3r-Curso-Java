package Fundamentos;

public class ExercicioTemperatura {
	public static void main (String[] args) {
		
//		(F - 32) x 5/9 = C
		
		int Fahrenheirt = 86;
		
		int F = 32;
		double divisao = 5/9.0;
		
		double celcius = (Fahrenheirt - F) * divisao;
	
		System.out.println(" O resultado é "  +"Cº " + celcius 	);
	}
	
}
